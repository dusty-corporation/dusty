function InitializeSetup: Boolean;
var
  Info: TJobLimits32;
  I: Integer;
begin
  { Silent deployment is explicit consent, not a suppressed affirmative dialog. }
  Result := False;
  if WizardSilent then
    if (ExpandConstant('{param:ACCEPTTERMS|}') <> 'yes') or
       (ExpandConstant('{param:ALLOWDOWNLOAD|}') <> 'yes') then Exit;
  { Inno 6 Setup is PE32. The compiler gate asserts this; no x64 struct guessing. }
  for I := 0 to 111 do Info[I] := 0;
  Info[17] := $20; { JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE, DWORD at offset 16. }
  DownloadJob := WinCreateJob(0, 0);
  Result := (DownloadJob <> 0) and WinSetJob(DownloadJob, 9, Info, 112);
  if Result then Result := WinAssignJob(DownloadJob, WinCurrentProcess);
  { Keep the non-inheritable handle until process exit: all children die with Setup. }
end;

function Quoted(Value: String): String;
begin
  Result := '"' + Value + '"';
end;

@@WIZARD_CODE@@

function InitializeUninstall: Boolean;
var
  Page: TSetupForm;
  Choice: TNewCheckBox;
  Help: TNewStaticText;
  Confirm, Cancel: TNewButton;
begin
  Result := False;
  RemoveModels := True;
#ifndef ReviewOnly
  if UninstallSilent then begin
    if ExpandConstant('{param:REMOVEMODELS|}') = 'yes' then begin
      RemoveModels := True;
      Result := True;
    end else if ExpandConstant('{param:REMOVEMODELS|}') = 'no' then begin
      RemoveModels := False;
      Result := True;
    end;
    Exit;
  end;
#endif
  Page := CreateCustomForm(ScaleX(500), ScaleY(160), True, True);
  try
    Page.ClientWidth := ScaleX(500);
    Page.ClientHeight := ScaleY(160);
    Page.Caption := CustomMessage('UninstallTitle');
    Choice := TNewCheckBox.Create(Page);
    Choice.Parent := Page;
    Choice.SetBounds(ScaleX(20), ScaleY(18), ScaleX(460), ScaleY(26));
    Choice.Caption := FmtMessage(CustomMessage('RemoveModels'), [UninstallModelSize]);
    Choice.Checked := True;
    Help := TNewStaticText.Create(Page);
    Help.Parent := Page;
    Help.SetBounds(ScaleX(20), ScaleY(54), ScaleX(460), ScaleY(32));
    Help.AutoSize := False;
    Help.WordWrap := True;
    Help.Caption := CustomMessage('RemoveModelsHelp');
    Confirm := TNewButton.Create(Page);
    Confirm.Parent := Page;
    Confirm.SetBounds(ScaleX(250), ScaleY(112), ScaleX(110), ScaleY(30));
    Confirm.Caption := CustomMessage('UninstallAction');
    Confirm.ModalResult := mrOk;
    Confirm.Default := False;
    Cancel := TNewButton.Create(Page);
    Cancel.Parent := Page;
    Cancel.SetBounds(ScaleX(370), ScaleY(112), ScaleX(110), ScaleY(30));
    Cancel.Caption := SetupMessage(msgButtonCancel);
    Cancel.ModalResult := mrCancel;
    Cancel.Cancel := True;
    Cancel.Default := True;
    Result := Page.ShowModal = mrOk;
    RemoveModels := Choice.Checked;
  finally
    Page.Free;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Mode: String;
  Code: Integer;
  Success: Boolean;
begin
  if CurUninstallStep = usUninstall then begin
    if RemoveModels then Mode := 'remove-models' else Mode := 'keep-models';
    Success := Exec(ExpandConstant('{app}\dusty\dusty.exe'), '--uninstall-data ' + Mode,
      ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, Code);
    if not Success or (Code <> 0) then
      SuppressibleMsgBox(CustomMessage('CleanupKept'), mbInformation, MB_OK, IDOK);
  end;
end;
