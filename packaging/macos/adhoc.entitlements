<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ad hoc builds only. With the hardened runtime, library validation lets a
  process load only libraries signed by Apple or by the same Team ID. Ad hoc
  signatures have no Team ID, so the PyInstaller bootloaders (Dusty, dusty-fetch)
  could not load their bundled libpython and Qt, and whisper-cli could not load
  its ggml libraries. tools/build_macos_app.py applies this file only to those
  executables and only when signing ad hoc. A Developer ID build signs every
  file with one Team ID and needs no entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
